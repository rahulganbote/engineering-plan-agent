# ────────────────────────────────────────────────────────────────────────────
# .env.example - Template for required + optional environment variables
# ────────────────────────────────────────────────────────────────────────────
#
# Copy to `secrets/.env` (the path is loaded explicitly in src/core/config.py):
#     cp .env.example secrets/.env
#
# Then fill in real values. `secrets/.env` is gitignored.
#
# All variables are case-insensitive (pydantic-settings).
# Unknown variables are ignored (no startup errors for typos in this template).
#
# Field names match src/core/config.py - when adding new settings, update both.
# ────────────────────────────────────────────────────────────────────────────


# ── OpenAI (required for default OpenAI runs) ────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-4o            # used by all specialists
OPENAI_MINI_MODEL=gpt-4o-mini          # used by Critic (cheaper, faster)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=1024


# ── Anthropic (required ONLY if model_family=anthropic in /run-pipeline) ─────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_MINI_MODEL=claude-haiku-4-5


# ── Pinecone (required for RAG) ──────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX=brd-knowledge-base
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.45


# ── LangSmith observability (recommended) ────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=em-copilot-brd-agent


# ── Google OAuth (required for sign-in) ──────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=809545615573-...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback  # on Cloud Run, set to https://<service-url>/auth/callback
SESSION_SECRET_KEY=change-me-to-a-long-random-string-in-prod


# ── Google Sheets export (required for HITL → Sheets write) ──────────────────
GOOGLE_SHEET_ID=1iQ8r2Z0qmXIS5lQCzMIhj7ePmq5kYPBxRhA_ud4Xq0I
# Path to service-account JSON key (CSV fallback is used if absent)
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google_service_account.json
# Alternative - base64-encoded SA key for Cloud Run (no file on disk)
GOOGLE_SA_B64=


# ── Jira integration (optional - Epic export via MCP) ────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
JIRA_ISSUE_TYPE=Epic                   # MCP path always Epic; REST fallback uses this value
JIRA_LABEL_PREFIX=em-copilot


# ── ElevenLabs voice (optional - used by HITL approval widget) ───────────────
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=


# ── Tavily web search (optional - used for web grounding fallback) ───────────
TAVILY_API_KEY=
# Monthly query cap (free tier = 1000). The tool tracks invocations per UTC
# month and returns a degraded ToolResult once exhausted (resets on month
# rollover). Set to 0 to disable enforcement (unlimited).
TAVILY_MONTHLY_BUDGET=1000

# ── GitHub (optional - used for metrics checking) ────────────────────────────
GITHUB_TOKEN=


# ── Slack (optional - pipeline error alerts; empty disables) ─────────────────
SLACK_WEBHOOK_URL=


# ── Redis L2 cache (optional - InMemoryCache is used if unset) ───────────────
# To start Redis locally for dev:   docker compose up -d redis
REDIS_URL=redis://localhost:6379


# ── Pipeline behavior knobs ──────────────────────────────────────────────────
# Set to 0 during local testing to disable Critic revisions (saves ~50% tokens)
MAX_CRITIC_REVISIONS=2
MAX_AGENT_RETRIES=2
PIPELINE_TIMEOUT_SEC=300
AGENT_TIMEOUT_SEC=90                   # per-agent bulkhead, OpenAI default
ANTHROPIC_AGENT_TIMEOUT_SEC=180        # Anthropic is 3-5x slower; per-family override
ENABLE_PROVIDER_FALLBACK=true          # set false to surface primary errors instead of auto-falling-back


# ── Semantic cache (optional - Phase 6 feature) ──────────────────────────────
# When 1, the Critic uses a Pinecone-backed semantic cache for near-duplicate queries
EM_SEMANTIC_CACHE=0
SEMANTIC_CACHE_THRESHOLD=0.95


# ── Security ─────────────────────────────────────────────────────────────────
MAX_BRD_FILE_SIZE_MB=5
INJECTION_LLM_CONFIDENCE_THRESHOLD=0.85
# Hard per-run cost ceiling (USD). The pipeline raises BudgetBreachedError
# the moment accumulated cost exceeds this value, halts execution, sets the
# run status to `error`, and fires a Slack alert. Tighten in production
# (e.g. 1.00) or loosen for stress testing (e.g. 10.00).
MAX_PIPELINE_RUN_BUDGET_USD=2.00


# ── Rate limits (slowapi syntax: "N/period") ────────────────────────────────
# Override per environment. Keyed by authenticated user email (falls back to IP).
# /run-pipeline applies BOTH per-day AND per-week caps; /approve uses per-hour.
# The 429 response carries a Retry-After header set to RATE_LIMIT_RETRY_AFTER_SEC.
RATE_LIMIT_RUN_PIPELINE_PER_DAY=5/day
RATE_LIMIT_RUN_PIPELINE_PER_WEEK=10/week
RATE_LIMIT_APPROVE_PER_HOUR=10/hour
RATE_LIMIT_RETRY_AFTER_SEC=3600


# ── FastAPI ──────────────────────────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
API_BASE=http://localhost:8000


# ── Email audit (optional - disabled when SMTP_HOST is empty) ────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
AUDIT_EMAIL=
